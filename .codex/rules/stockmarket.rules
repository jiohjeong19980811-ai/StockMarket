# Project-local rules load only after the project .codex layer is trusted.

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publishing changes remote repository state; prompt keeps force-push/history-rewrite variants outside autonomous approval.",
    match = ["git push origin feature/m7-backtest-read-api"],
)

prefix_rule(
    pattern = ["gh", "issue", "create"],
    decision = "prompt",
    justification = "Creating public project-tracking artifacts should be operator-approved.",
    match = ["gh issue create --title \"MVP: data ingestion\""],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "allow",
    justification = "Operator approved creating pull requests for validated StockMarket feature branches.",
    match = ["gh pr create --fill"],
)

prefix_rule(
    pattern = ["gh", "pr", "view"],
    decision = "allow",
    justification = "Viewing pull request metadata is routine repository inspection.",
    match = ["gh pr view"],
)

prefix_rule(
    pattern = ["gh", "pr", "checks"],
    decision = "allow",
    justification = "Watching pull request checks is required before merge.",
    match = ["gh pr checks --watch"],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "allow",
    justification = "Operator approved merging validated StockMarket pull requests after checks pass; no force-push or history rewrite is allowed.",
    match = ["gh pr merge --merge --delete-branch"],
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "Adding or changing dependencies affects the supply-chain risk profile.",
    match = ["npm install"],
)

prefix_rule(
    pattern = ["pnpm", "add"],
    decision = "prompt",
    justification = "Adding dependencies should be reviewed for license, security, and maintenance risk.",
    match = ["pnpm add zod"],
)

prefix_rule(
    pattern = ["python", "-m", "pip", "install"],
    decision = "prompt",
    justification = "Adding Python dependencies should be reviewed for license, security, and reproducibility.",
    match = ["python -m pip install pandas"],
)
