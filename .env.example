# Optional local configuration reference.
# A local .env file is not required while the app uses mocks and fixtures.
# Copy this file to .env only when a local workflow explicitly needs real provider keys.

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000

# Local SQLite/libSQL database for the MVP.
DATABASE_URL=file:stockmarket-dev.db

# OpenAI, optional for future research summarization and agent workflows when enabled.
OPENAI_API_KEY=replace_with_local_secret

# Provider-specific keys are optional and inactive until adapter terms are reviewed.
# Current code uses mocks by default.
POLYGON_API_KEY=replace_with_local_secret
FMP_API_KEY=replace_with_local_secret
FINNHUB_API_KEY=replace_with_local_secret

# Future optional providers. Leave unset until selected and documented.
FRED_API_KEY=replace_with_local_secret
SEC_EDGAR_USER_AGENT=replace_with_local_contact

# Broker integrations are deferred. Do not add broker credentials in MVP.
LIVE_TRADING_ENABLED=false
