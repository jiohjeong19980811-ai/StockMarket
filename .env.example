# Copy this file to .env locally and fill in real values outside version control.

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stockmarket_dev

# OpenAI, used only for research summarization and agent workflows when enabled.
OPENAI_API_KEY=replace_with_local_secret

# Market and news providers. Leave blank until a provider is selected.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=replace_with_local_secret
OPTIONS_DATA_PROVIDER=
OPTIONS_DATA_API_KEY=replace_with_local_secret
NEWS_PROVIDER=
NEWS_API_KEY=replace_with_local_secret
FUNDAMENTALS_PROVIDER=
FUNDAMENTALS_API_KEY=replace_with_local_secret
EARNINGS_PROVIDER=
EARNINGS_API_KEY=replace_with_local_secret
SENTIMENT_PROVIDER=
SENTIMENT_API_KEY=replace_with_local_secret

# Future paper broker integration only. Do not use live trading credentials in MVP.
BROKER_PROVIDER=
BROKER_PAPER_API_KEY=replace_with_local_secret
BROKER_PAPER_API_SECRET=replace_with_local_secret
LIVE_TRADING_ENABLED=false
